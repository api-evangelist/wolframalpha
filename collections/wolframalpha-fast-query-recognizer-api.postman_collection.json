          "name": "Wolfram|Alpha Recognize and Classify Query",
          "request": {
            "name": "Wolfram|Alpha Recognize and Classify Query",
            "description": {
              "content": "Submit a natural language query and receive a classification result indicating whether the query is appropriate for Wolfram|Alpha, the likely domain, and a result significance score. Completes in under 10 milliseconds.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "query.jsp"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "appid",
                  "value": "<string>",
                  "description": "(Required) Wolfram|Alpha AppID for authentication."
                },
                {
                  "disabled": false,
                  "key": "mode",
                  "value": "<string>",
                  "description": "(Required) Recognition mode. Default is for typed queries; Voice optimizes for spoken input."
                },
                {
                  "disabled": false,
                  "key": "i",
                  "value": "<string>",
                  "description": "(Required) URL-encoded input query string to classify."
                },
                {
                  "disabled": false,
                  "key": "output",
                  "value": "<string>",
                  "description": "Response format. Default is XML."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
