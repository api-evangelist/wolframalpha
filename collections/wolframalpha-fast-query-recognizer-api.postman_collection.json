  "info": {
    "_postman_id": "35d637b7-76c9-47e2-938d-9517d446a60c",
    "name": "Wolfram|Alpha Fast Query Recognizer API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Wolfram|Alpha Fast Query Recognizer API rapidly classifies a natural language query in under 10 milliseconds to determine whether Wolfram|Alpha is likely to return a useful response. Useful for routing layers that need to decide whether to invoke the heavier Full Results, Short Answers, or LLM APIs. Supports two recognition modes: Default for typed queries and Voice for spoken input.\n\nContact Support:\n Name: Wolfram|Alpha Developer Support",
      "type": "text/plain"
    }
  }
