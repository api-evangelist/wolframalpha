            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/query.jsp?appid=<string>&mode=Default&i=<string>&output=xml",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "query.jsp"
              ],
              "query": [
                {
                  "description": "(Required) Wolfram|Alpha AppID for authentication.",
                  "key": "appid",
                  "value": "<string>"
                },
                {
                  "description": "(Required) Recognition mode. Default is for typed queries; Voice optimizes for spoken input.",
                  "key": "mode",
                  "value": "Default"
                },
                {
                  "description": "(Required) URL-encoded input query string to classify.",
                  "key": "i",
                  "value": "<string>"
                },
                {
                  "description": "Response format. Default is XML.",
                  "key": "output",
                  "value": "xml"
                }
              ]
            },
            "description": "Submit a natural language query and receive a classification result indicating whether the query is appropriate for Wolfram|Alpha, the likely domain, and a result significance score. Completes in under 10 milliseconds."
