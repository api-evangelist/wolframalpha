{
  "info": {
    "_postman_id": "a227c725-4565-4736-8884-00aeaf35eb91",
    "name": "Wolfram|Alpha Simple API",
    "description": "The Wolfram|Alpha Simple API generates complete Wolfram|Alpha results as a rendered static image, requiring minimal coding effort. It is suitable for quickly embedding computational results visually in web applications without handling complex structured data. The image background, foreground, font size, and width are all customizable.\n\nContact Support:\n Name: Wolfram|Alpha Developer Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:21:27.000Z",
    "updatedAt": "2026-06-05T15:21:27.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-a227c725-4565-4736-8884-00aeaf35eb91"
  },
