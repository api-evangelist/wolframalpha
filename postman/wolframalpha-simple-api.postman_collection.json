      "item": [
        {
          "name": "Wolfram|Alpha Get Simple Image Result",
          "id": "75529a59-cd31-4dec-aa6e-cb2af5a002bb",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "image/gif"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/simple?appid=<string>&i=<string>&layout=labelbar&background=<string>&foreground=white&fontsize=<integer>&width=<integer>&units=metric&timeout=<integer>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "simple"
              ],
              "query": [
                {
                  "description": "(Required) Wolfram|Alpha AppID for authentication.",
                  "key": "appid",
                  "value": "<string>"
                },
                {
                  "description": "(Required) URL-encoded input query string.",
                  "key": "i",
                  "value": "<string>"
                },
                {
                  "description": "Content presentation style. Values are divider (default) or labelbar.",
                  "key": "layout",
                  "value": "labelbar"
                },
                {
                  "description": "Image background color as HTML color name, hex value, or RGB value.",
                  "key": "background",
                  "value": "<string>"
                },
                {
                  "description": "Text color. Values are black (default) or white.",
                  "key": "foreground",
                  "value": "white"
                },
                {
                  "description": "Font size in points for rendered text. Default is 14.",
                  "key": "fontsize",
                  "value": "<integer>"
                },
                {
                  "description": "Image width in pixels. Default is 500.",
                  "key": "width",
                  "value": "<integer>"
                },
                {
                  "description": "Measurement system preference. Values are metric or imperial.",
                  "key": "units",
                  "value": "metric"
                },
                {
                  "description": "Maximum processing time in seconds. Default is 5.",
                  "key": "timeout",
                  "value": "<integer>"
                }
              ]
            },
            "description": "Submit a natural language query and receive the complete Wolfram|Alpha result rendered as a static image. Customizable background, foreground, font size, and width. Does not support disambiguation, drilldown, or asynchronous delivery."
          },
